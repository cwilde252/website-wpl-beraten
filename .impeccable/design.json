  "components": [
    {
      "name": "Primärer Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Haupt-Handlungsaufforderung, z. B. „Erstgespräch vereinbaren“.",
      "html": "<a class=\"ds-btn\" href=\"#\"><span>Erstgespräch vereinbaren</span><svg class=\"ds-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h13\"/><path d=\"m13 6 6 6-6 6\"/></svg></a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:.625rem;min-height:3rem;padding:.8rem 1.35rem;border:1px solid transparent;border-radius:.75rem;background:#1d2731;color:#fff;font-family:'Figtree Variable',system-ui,sans-serif;font-size:1rem;font-weight:600;line-height:1.2;text-decoration:none;transition:background-color 160ms cubic-bezier(.16,1,.3,1),transform 160ms cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:#2e3d4b}.ds-btn:active{transform:scale(.98)}.ds-btn:focus-visible{outline:2px solid #1d2731;outline-offset:3px}.ds-arrow{width:1.1em;height:1.1em;transition:transform 280ms cubic-bezier(.16,1,.3,1)}.ds-btn:hover .ds-arrow{transform:translateX(3px)}"
    },
    {
      "name": "Ruhiger Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Zweitrangige Aktion auf neutraler Fläche (Footer).",
      "html": "<a class=\"ds-btn-quiet\" href=\"#\">Erstgespräch vereinbaren</a>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;min-height:3rem;padding:.8rem 1.35rem;border:1px solid #7d868f;border-radius:.75rem;background:#fff;color:#1d2731;font-family:'Figtree Variable',system-ui,sans-serif;font-weight:600;text-decoration:none;transition:background-color 160ms cubic-bezier(.16,1,.3,1)}.ds-btn-quiet:hover{background:#f3f4f1}.ds-btn-quiet:focus-visible{outline:2px solid #1d2731;outline-offset:3px}"
    },
    {
      "name": "Textlink",
      "kind": "custom",
      "refersTo": "link",
      "description": "Sekundäre Aktion; färbt sich beim Hover in den Ton des Blatts.",
      "html": "<div class=\"ds-tone-beratung\" style=\"padding:1rem\"><a class=\"ds-link\" href=\"#\">Mehr zu Beratung →</a></div>",
      "css": ".ds-tone-beratung{background:#e5eff8;--tone-ink:#1e5e8e}.ds-link{display:inline-flex;align-items:center;min-height:2.75rem;color:#1d2731;font-family:'Figtree Variable',system-ui,sans-serif;font-weight:600;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.3em;text-decoration-color:rgb(29 39 49 / .45);transition:color 160ms cubic-bezier(.16,1,.3,1)}.ds-link:hover{color:var(--tone-ink,#1d2731);text-decoration-color:currentColor}.ds-link:focus-visible{outline:2px solid #1d2731;outline-offset:3px}"
    },
    {
      "name": "Registerblatt mit Reiter",
      "kind": "card",
      "refersTo": "sheet-pruefung",
      "description": "Das tragende Element: getönte Fläche, Reiter wächst mit konkavem Übergang heraus und ist eine echte Überschrift.",
      "html": "<div class=\"ds-sheet\"><h3 class=\"ds-tab\"><span class=\"ds-dot\" aria-hidden=\"true\"></span>Wirtschaftsprüfung</h3><p class=\"ds-claim\">Ein Prüfungsansatz, der zur Größe Ihres Unternehmens passt.</p></div>",
      "css": ".ds-sheet{position:relative;margin-top:2.75rem;background:#fdedda;border-radius:0 1.75rem 1.75rem 1.75rem;padding:clamp(1.5rem,4vw,3.5rem);color:#1d2731}.ds-tab{position:absolute;bottom:100%;left:0;margin:0;display:inline-flex;align-items:center;gap:.55rem;min-height:2.75rem;padding:.55rem 1.15rem .35rem;box-sizing:border-box;background:#fdedda;color:#8f4a00;border-radius:.875rem .875rem 0 0;font-family:'Figtree Variable',system-ui,sans-serif;font-size:.9375rem;font-weight:650;line-height:1.2;white-space:nowrap}.ds-tab::after{content:'';position:absolute;bottom:0;left:100%;width:.875rem;height:.875rem;background:radial-gradient(circle at 100% 0,transparent calc(.875rem - .5px),#fdedda .875rem)}.ds-dot{width:.5rem;height:.5rem;border-radius:50%;background:#d4780a}.ds-claim{margin:0;font-family:'Bricolage Grotesque Variable',sans-serif;font-size:1.375rem;font-weight:600;letter-spacing:-.015em;line-height:1.2}"
    },
    {
      "name": "Deckblatt",
      "kind": "card",
      "refersTo": "cover",
      "description": "Weißes Deckblatt vorn im Hero-Stapel; trägt den einzigen Schatten des Systems.",
      "html": "<div class=\"ds-cover\"><p class=\"ds-cover-name\">Wiebke Lefevre</p><p class=\"ds-soft\">Wirtschaftsprüferin</p><dl class=\"ds-facts\"><div><dt>Ort</dt><dd>Rottweil</dd></div><div><dt>Selbständig</dt><dd>seit 2026</dd></div></dl></div>",
      "css": ".ds-cover{padding:clamp(1.5rem,3vw,2.25rem);background:#fff;border:1px solid #e1e4e0;border-radius:1.75rem;box-shadow:0 1.5rem 3rem -1.75rem rgb(29 39 49 / .35);color:#1d2731;font-family:'Figtree Variable',system-ui,sans-serif}.ds-cover p{margin:0}.ds-cover-name{font-family:'Bricolage Grotesque Variable',sans-serif;font-size:1.75rem;font-weight:600;letter-spacing:-.025em;line-height:1.1}.ds-soft{color:#4a5561}.ds-facts{display:flex;gap:.75rem 2rem;margin:1.5rem 0 0;padding-top:1.25rem;border-top:1px solid #e1e4e0}.ds-facts dt{font-size:.875rem;color:#4a5561}.ds-facts dd{margin:0;font-weight:600}"
    },
    {
      "name": "Leistungs-Reiter",
      "kind": "nav",
      "refersTo": "service-tabs",
      "description": "Tablist: gewählter Reiter steht oben, die anderen stecken tiefer; Panel färbt sich in den Ton.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-rtab ds-p\" role=\"tab\" aria-selected=\"true\"><span class=\"ds-dot\"></span>Wirtschaftsprüfung</button><button class=\"ds-rtab ds-b\" role=\"tab\" aria-selected=\"false\"><span class=\"ds-dot\"></span>Beratung</button><button class=\"ds-rtab ds-s\" role=\"tab\" aria-selected=\"false\"><span class=\"ds-dot\"></span>Steuern</button></div><div class=\"ds-panel\">Panel im Ton des gewählten Bereichs</div>",
      "css": ".ds-tabs{display:flex;gap:.375rem;align-items:flex-end}.ds-rtab{display:inline-flex;align-items:center;gap:.6rem;min-height:3.25rem;padding:.75rem 1.25rem .6rem;border:0;border-radius:.875rem .875rem 0 0;font-family:'Figtree Variable',system-ui,sans-serif;font-size:1rem;font-weight:650;cursor:pointer;transform:translateY(.5rem);transition:transform 280ms cubic-bezier(.16,1,.3,1)}.ds-rtab:hover{transform:translateY(.2rem)}.ds-rtab[aria-selected=true]{transform:none;padding-bottom:.85rem}.ds-rtab:focus-visible{outline:2px solid #1d2731;outline-offset:-4px}.ds-p{background:#fdedda;color:#8f4a00}.ds-p .ds-dot{background:#d4780a}.ds-b{background:#e5eff8;color:#1e5e8e}.ds-b .ds-dot{background:#2e7db8}.ds-s{background:#e2f1e7;color:#1c6a40}.ds-s .ds-dot{background:#2d8b57}.ds-dot{width:.5rem;height:.5rem;border-radius:50%}.ds-panel{position:relative;background:#fdedda;border-radius:0 1.75rem 1.75rem 1.75rem;padding:2rem;color:#1d2731;font-family:'Figtree Variable',system-ui,sans-serif}"
    },
    {
      "name": "Eingabefeld",
      "kind": "input",
      "refersTo": "field",
      "description": "Zahlenfeld im Prüfungspflicht-Check; Fehler über Randstärke und Text.",
      "html": "<label class=\"ds-label\" for=\"ds-f\">Bilanzsumme in Euro</label><input id=\"ds-f\" class=\"ds-field\" inputmode=\"numeric\" value=\"7.500.000\"><input class=\"ds-field\" aria-invalid=\"true\" value=\"abc\" style=\"margin-top:.75rem\" aria-label=\"Fehlerbeispiel\"><p class=\"ds-error\">Bitte eine Zahl eingeben.</p>",
      "css": ".ds-label{display:block;margin-bottom:.4rem;font-family:'Figtree Variable',system-ui,sans-serif;font-size:.9375rem;font-weight:600;color:#1d2731}.ds-field{display:block;width:100%;box-sizing:border-box;min-height:3rem;padding:.65rem .9rem;background:#fff;color:#1d2731;font-family:'Figtree Variable',system-ui,sans-serif;font-size:1.0625rem;font-variant-numeric:tabular-nums;border:1px solid #7d868f;border-radius:.75rem;transition:border-color 160ms cubic-bezier(.16,1,.3,1),box-shadow 160ms cubic-bezier(.16,1,.3,1)}.ds-field:hover{border-color:#4a5561}.ds-field:focus-visible{outline:none;border-color:#1d2731;box-shadow:0 0 0 3px rgb(29 39 49 / .22)}.ds-field[aria-invalid=true]{border-color:#8f4a00;border-width:2px}.ds-error{margin:.4rem 0 0;font-family:'Figtree Variable',system-ui,sans-serif;font-size:.9375rem;color:#8f4a00}"
    },
    {
      "name": "Hauptnavigation",
      "kind": "nav",
